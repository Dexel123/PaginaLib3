<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.paginalib3.controller.DashboardCajeroController"
            style="-fx-background-color:#F7F1E8; -fx-font-family:'Segoe UI';">
    <left>
        <VBox prefWidth="245" spacing="16" style="-fx-background-color:#3B1720;">
            <padding><Insets top="28" right="20" bottom="22" left="20"/></padding>
            <Label text="PÁGINA" style="-fx-text-fill:#FFF8EF; -fx-font-size:25px; -fx-font-weight:bold;"/>
            <Label text="LIBRERÍA" style="-fx-text-fill:#D9A441; -fx-font-size:12px; -fx-font-weight:bold;"/>
            <Region prefHeight="4"/>
            <VBox spacing="4" style="-fx-background-color:#54232E; -fx-background-radius:12; -fx-padding:14;">
                <Label text="SESION ACTIVA" style="-fx-text-fill:#D9A441; -fx-font-size:10px; -fx-font-weight:bold;"/>
                <Label fx:id="lblNombreUsuario" wrapText="true" style="-fx-text-fill:#FFF8EF; -fx-font-size:15px; -fx-font-weight:bold;"/>
                <Label fx:id="lblRolUsuario" style="-fx-text-fill:#E9D9C4; -fx-font-size:11px;"/>
            </VBox>
            <Label text="CAJA" style="-fx-text-fill:#CDB7A5; -fx-font-size:10px; -fx-font-weight:bold;"/>
            <Button text="  INICIO" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#actualizarVentas"
                    style="-fx-background-color:#D9A441; -fx-text-fill:#3B1720; -fx-font-size:13px; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:12 14; -fx-cursor:hand;"/>
            <Button text="  BUSCAR LIBROS" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#irABuscarLibros"
                    style="-fx-background-color:transparent; -fx-text-fill:#FFF8EF; -fx-font-size:13px; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:12 14; -fx-cursor:hand;"/>
            <Button text="  NUEVA VENTA" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#irACaja"
                    style="-fx-background-color:#7A2938; -fx-text-fill:#FFF8EF; -fx-font-size:13px; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:12 14; -fx-cursor:hand;"/>
            <Button text="  ANULACIONES / DEVOLUCIONES" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#irADevolucion"
                    style="-fx-background-color:transparent; -fx-text-fill:#FFF8EF; -fx-font-size:12px; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:12 14; -fx-cursor:hand;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Cerrar sesión" maxWidth="Infinity" onAction="#cerrarSesion"
                    style="-fx-background-color:#8F3D45; -fx-text-fill:#FFF8EF; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:11 14; -fx-cursor:hand;"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="18">
            <padding><Insets top="26" right="30" bottom="26" left="30"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="4">
                    <Label text="Panel de caja" style="-fx-text-fill:#3B1720; -fx-font-size:29px; -fx-font-weight:bold;"/>
                    <Label fx:id="lblSaludo" wrapText="true" style="-fx-text-fill:#765F55; -fx-font-size:13px;"/>
                </VBox>
            </HBox>

            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="5" style="-fx-background-color:#3B1720; -fx-background-radius:14; -fx-padding:16;">
                    <Label text="VENTAS COMPLETADAS" style="-fx-text-fill:#E9D9C4; -fx-font-size:10px; -fx-font-weight:bold;"/>
                    <Label fx:id="lblCantidadVentas" text="0" style="-fx-text-fill:#FFF8EF; -fx-font-size:28px; -fx-font-weight:bold;"/>
                    <Label text="registradas hoy" style="-fx-text-fill:#CDB7A5; -fx-font-size:11px;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5" style="-fx-background-color:#FFFDF9; -fx-background-radius:14; -fx-border-color:#E5D8C8; -fx-border-radius:14; -fx-padding:16;">
                    <Label text="TOTAL VENDIDO" style="-fx-text-fill:#765F55; -fx-font-size:10px; -fx-font-weight:bold;"/>
                    <Label fx:id="lblTotalVendido" text="Q0.00" style="-fx-text-fill:#7A2938; -fx-font-size:28px; -fx-font-weight:bold;"/>
                    <Label text="ventas completadas" style="-fx-text-fill:#9A857A; -fx-font-size:11px;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5" style="-fx-background-color:#F0D9A6; -fx-background-radius:14; -fx-padding:16;">
                    <Label text="CAJERO" style="-fx-text-fill:#6B3A12; -fx-font-size:10px; -fx-font-weight:bold;"/>
                    <Label fx:id="lblUsuarioMetric" style="-fx-text-fill:#3B1720; -fx-font-size:21px; -fx-font-weight:bold;"/>
                    <Label text="sesión autorizada" style="-fx-text-fill:#765F55; -fx-font-size:11px;"/>
                </VBox>
            </HBox>

            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="7" style="-fx-background-color:#FFFDF9; -fx-background-radius:14; -fx-border-color:#E5D8C8; -fx-border-radius:14; -fx-padding:15;">
                    <Label text="OPERACIÓN PRINCIPAL" style="-fx-text-fill:#9A857A; -fx-font-size:10px; -fx-font-weight:bold;"/>
                    <Label text="Registrar una nueva venta" style="-fx-text-fill:#3B1720; -fx-font-size:16px; -fx-font-weight:bold;"/>
                    <Label text="Buscar libros, agregar cantidades, aplicar descuentos autorizados y calcular el total." wrapText="true" style="-fx-text-fill:#765F55; -fx-font-size:11px;"/>
                    <Button text="Registrar venta" maxWidth="Infinity" onAction="#irACaja"
                            style="-fx-background-color:#7A2938; -fx-text-fill:#FFF8EF; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:11 14; -fx-cursor:hand;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="7" style="-fx-background-color:#FFFDF9; -fx-background-radius:14; -fx-border-color:#E5D8C8; -fx-border-radius:14; -fx-padding:15;">
                    <Label text="CONSULTA Y POSTVENTA" style="-fx-text-fill:#9A857A; -fx-font-size:10px; -fx-font-weight:bold;"/>
                    <Label text="Buscar o gestionar ventas" style="-fx-text-fill:#3B1720; -fx-font-size:16px; -fx-font-weight:bold;"/>
                    <Label text="Consulta libros disponibles o gestiona una anulación/devolución reciente." wrapText="true" style="-fx-text-fill:#765F55; -fx-font-size:11px;"/>
                    <HBox spacing="8">
                        <Button text="Buscar libros" HBox.hgrow="ALWAYS" onAction="#irABuscarLibros"
                                style="-fx-background-color:#D9A441; -fx-text-fill:#3B1720; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:10 12; -fx-cursor:hand;"/>
                        <Button text="Devoluciones" HBox.hgrow="ALWAYS" onAction="#irADevolucion"
                                style="-fx-background-color:#EFE4D6; -fx-text-fill:#5A3039; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:10 12; -fx-cursor:hand;"/>
                    </HBox>
                </VBox>
            </HBox>

            <VBox VBox.vgrow="ALWAYS" spacing="9" style="-fx-background-color:#FFFDF9; -fx-background-radius:14; -fx-border-color:#E5D8C8; -fx-border-radius:14; -fx-padding:16;">
                <HBox alignment="CENTER_LEFT">
                    <VBox HBox.hgrow="ALWAYS" spacing="2">
                        <Label text="Ventas realizadas hoy" style="-fx-text-fill:#3B1720; -fx-font-size:17px; -fx-font-weight:bold;"/>
                        <Label fx:id="lblEstadoVentas" style="-fx-text-fill:#765F55; -fx-font-size:11px;"/>
                    </VBox>
                    <Button text="Actualizar" onAction="#actualizarVentas"
                            style="-fx-background-color:#EFE4D6; -fx-text-fill:#5A3039; -fx-font-weight:bold; -fx-background-radius:8; -fx-padding:8 12; -fx-cursor:hand;"/>
                </HBox>
                <TableView fx:id="tblVentas" VBox.vgrow="ALWAYS" style="-fx-background-color:#FFFDF9; -fx-border-color:#E5D8C8; -fx-border-radius:8;">
                    <columns>
                        <TableColumn fx:id="colVenta" text="# Venta" prefWidth="90"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
                        <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="130"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
