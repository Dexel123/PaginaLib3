<?xml version='1.0' encoding='UTF-8'?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalib3.controller.BuscarLibroController" styleClass="root">
   <top>
      <VBox spacing="10" styleClass="card">
         <padding>
            <Insets top="24" right="24" bottom="18" left="24"/>
         </padding>
         <Label text="Buscar libros" styleClass="title-label"/>
         <HBox spacing="10">
            <TextField fx:id="txtBuscar" promptText="ISBN, título o autor" HBox.hgrow="ALWAYS" onAction="#buscar"/>
            <Button text="Buscar" styleClass="btn-primary" onAction="#buscar"/>
            <Button text="Limpiar" styleClass="btn-secondary" onAction="#limpiar"/>
         </HBox>
         <Label fx:id="lblEstado" styleClass="subtitle-label"/>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tblLibros">
         <columns>
            <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="150"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="260"/>
            <TableColumn fx:id="colAutores" text="Autor(es)" prefWidth="260"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="110"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="90"/>
         </columns>
      </TableView>
   </center>
   <bottom>
      <HBox spacing="10" alignment="CENTER_RIGHT">
         <padding>
            <Insets top="14" right="20" bottom="20" left="20"/>
         </padding>
         <Button text="Registrar venta" styleClass="btn-primary" onAction="#irACaja"/>
         <Button text="Volver" styleClass="btn-secondary" onAction="#volver"/>
      </HBox>
   </bottom>
</BorderPane>
