<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.paginalib3.controller.SalidaInventarioController"
            styleClass="root">

    <top>
        <VBox spacing="5" styleClass="card">
            <padding>
                <Insets top="22" right="24" bottom="18" left="24"/>
            </padding>
            <Label text="Registrar salida de inventario" styleClass="title-label"/>
            <Label text="Registra mermas, traslados o devoluciones a proveedor y actualiza el stock automáticamente."
                   wrapText="true" styleClass="subtitle-label"/>
            <Label fx:id="lblEstado" styleClass="subtitle-label"/>
        </VBox>
    </top>

    <center>
        <HBox spacing="18" fillHeight="true">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <VBox spacing="12" prefWidth="420" styleClass="card">
                <Label text="Datos de la salida" styleClass="section-label"/>

                <GridPane hgap="10" vgap="10">
                    <Label text="Libro:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbLibro" promptText="Seleccione un libro"
                              prefWidth="285" GridPane.rowIndex="0" GridPane.columnIndex="1"
                              onAction="#seleccionarLibro"/>

                    <Label text="Stock:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblStock" text="Stock disponible: --"
                           styleClass="subtitle-label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Tipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbTipoSalida" prefWidth="285"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label fx:id="lblProveedor" text="Proveedor:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbProveedor" promptText="Solo para devolución"
                              prefWidth="285" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Cantidad:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCantidad" promptText="Ej. 2"
                               prefWidth="285" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <Label text="Observación / motivo:" styleClass="section-label"/>
                <TextArea fx:id="txtMotivo" promptText="Escriba el motivo de la salida..."
                          prefRowCount="5" wrapText="true"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button text="Limpiar" styleClass="btn-secondary" onAction="#limpiarFormulario"/>
                    <Button text="Registrar salida" styleClass="btn-primary" onAction="#registrarSalida"/>
                </HBox>
            </VBox>

            <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="card">
                <Label text="Stock disponible" styleClass="section-label"/>
                <Label text="Seleccione un libro del formulario para registrar su salida."
                       wrapText="true" styleClass="subtitle-label"/>
                <TableView fx:id="tblStock" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="135"/>
                        <TableColumn fx:id="colTitulo" text="Título" prefWidth="260"/>
                        <TableColumn fx:id="colStock" text="Stock" prefWidth="80"/>
                        <TableColumn fx:id="colMinimo" text="Mínimo" prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <padding>
                <Insets top="8" right="24" bottom="20" left="24"/>
            </padding>
            <Button text="Volver al panel de bodega" styleClass="btn-secondary" onAction="#volver"/>
        </HBox>
    </bottom>
</BorderPane>
