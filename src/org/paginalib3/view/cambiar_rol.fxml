<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.paginalib3.controller.CambiarRolController"
      spacing="12" styleClass="root">
    <padding>
        <Insets top="26" right="26" bottom="26" left="26"/>
    </padding>

    <Label text="Cambiar rol" styleClass="title-label"/>
    <Label fx:id="lblUsuario" styleClass="subtitle-label"/>

    <ComboBox fx:id="cmbRol" maxWidth="Infinity"/>

    <Label fx:id="lblEstado" styleClass="error-label" wrapText="true"/>

    <HBox spacing="10">
        <Button text="Guardar" styleClass="btn-primary" onAction="#guardar"/>
        <Button text="Cancelar" styleClass="btn-secondary" onAction="#cancelar"/>
    </HBox>
</VBox>
