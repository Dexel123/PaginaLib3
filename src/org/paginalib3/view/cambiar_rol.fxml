<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.paginalib3.controller.CambiarRolController"
      spacing="12"
      style="-fx-background-color:#F7F1E8; -fx-font-family:'Segoe UI';">
    <padding>
        <Insets top="26" right="26" bottom="26" left="26"/>
    </padding>
    <VBox spacing="12"
          style="-fx-background-color:#FFFDF9; -fx-background-radius:14; -fx-border-color:#E5D8C8; -fx-border-radius:14; -fx-padding:20;">
        <Label text="Cambiar rol" style="-fx-text-fill:#3B1720; -fx-font-size:22px; -fx-font-weight:bold;"/>
        <Label fx:id="lblUsuario" style="-fx-text-fill:#765F55; -fx-font-size:13px;"/>
        <ComboBox fx:id="cmbRol" maxWidth="Infinity"
                  style="-fx-background-color:#F6EFE5; -fx-background-radius:9; -fx-border-color:#E5D8C8; -fx-border-radius:9; -fx-pref-height:38;"/>
        <Label fx:id="lblEstado" style="-fx-text-fill:#D9534F; -fx-font-weight:bold;" wrapText="true"/>
        <HBox spacing="10">
            <Button text="Guardar" onAction="#guardar"
                    style="-fx-background-color:#7A2938; -fx-text-fill:#FFF8EF; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:11 14; -fx-cursor:hand;"/>
            <Button text="Cancelar" onAction="#cancelar"
                    style="-fx-background-color:#EFE4D6; -fx-text-fill:#5A3039; -fx-font-weight:bold; -fx-background-radius:9; -fx-padding:10 12; -fx-cursor:hand;"/>
        </HBox>
    </VBox>
</VBox>