<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.paginalib3.controller.RegistroController"
      alignment="CENTER" spacing="12" styleClass="root">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <VBox maxWidth="460" spacing="12" styleClass="card">
        <Label text="Crear cuenta" styleClass="title-label"/>
        <Label text="Registra tu usuario para acceder a Pagina-Libreria." styleClass="subtitle-label"/>

        <TextField fx:id="txtUsername" promptText="Usuario"/>
        <TextField fx:id="txtNombre" promptText="Nombre"/>
        <TextField fx:id="txtApellido" promptText="Apellido"/>
        <TextField fx:id="txtCorreo" promptText="Correo"/>
        <ComboBox fx:id="cmbRol" maxWidth="Infinity" promptText="Rol"/>
        <PasswordField fx:id="txtPassword" promptText="Contraseña"/>
        <PasswordField fx:id="txtConfirmar" promptText="Confirmar contraseña"/>

        <Label fx:id="lblEstado" styleClass="error-label" wrapText="true"/>

        <HBox spacing="10">
            <Button text="Registrarme" styleClass="btn-primary" onAction="#registrar"/>
            <Button text="Volver al login" styleClass="btn-secondary" onAction="#volver"/>
        </HBox>
    </VBox>
</VBox>
