<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="org.paginalib3.controller.UsuariosController" 
      spacing="18" 
      styleClass="root">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>
    <Label text="Gestion de usuarios" styleClass="title-label"/>
    <Label text="Registra y administra las cuentas del sistema." styleClass="subtitle-label"/>
    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colUsername" text="Usuario" prefWidth="140"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <Button text="+ Registrar usuario" styleClass="btn-primary" onAction="#registrar"/>
        <Button text="Editar datos" styleClass="btn-secondary" onAction="#editar"/>
        <Button text="Cambiar rol" styleClass="btn-secondary" onAction="#cambiarRol"/>
        <Button text="Activar / desactivar" styleClass="btn-secondary" onAction="#cambiarEstado"/>
        <Button text="Volver" styleClass="btn-secondary" onAction="#volver"/>
    </HBox>
</VBox>