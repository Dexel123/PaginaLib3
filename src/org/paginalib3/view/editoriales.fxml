<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.paginalib3.controller.EditorialesController"
            styleClass="app-root">
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="page-header">
            <Button text="← Volver" onAction="#volver" styleClass="btn-light"/>
            <VBox HBox.hgrow="ALWAYS">
                <Label text="Gestión de editoriales" styleClass="page-title-light"/>
                <Label text="Registra y consulta las editoriales disponibles para el catálogo." styleClass="page-subtitle-light"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="14" styleClass="content-panel">
            <HBox spacing="10" alignment="BOTTOM_LEFT">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="NIT"/>
                    <TextField fx:id="txtNit" promptText="Ej. 1007-G"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Nombre de la editorial"/>
                    <TextField fx:id="txtNombre" promptText="Ej. Editorial Nueva"/>
                </VBox>
                <Button text="+ Crear editorial" onAction="#guardar" styleClass="btn-accent"/>
            </HBox>

            <Label text="Editoriales registradas" styleClass="section-title"/>

            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colNit" text="NIT" prefWidth="180"/>
                    <TableColumn fx:id="colNombre" text="Editorial" prefWidth="420"/>
                </columns>
            </TableView>

            <Label fx:id="lblEstado" text="Listo." styleClass="status-strip" maxWidth="Infinity"/>
        </VBox>
    </center>
</BorderPane>
