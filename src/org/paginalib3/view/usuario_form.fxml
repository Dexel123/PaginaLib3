<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.paginalib3.controller.UsuarioFormController"
      spacing="12" styleClass="root">
    <padding>
        <Insets top="26" right="26" bottom="26" left="26"/>
    </padding>

    <Label fx:id="lblTitulo" text="Registrar usuario" styleClass="title-label"/>

    <TextField fx:id="txtUsername" promptText="Usuario"/>
    <PasswordField fx:id="txtPassword" promptText="Contrasena"/>
    <TextField fx:id="txtNombre" promptText="Nombre"/>
    <TextField fx:id="txtApellido" promptText="Apellido"/>
    <TextField fx:id="txtCorreo" promptText="Correo"/>
    <ComboBox fx:id="cmbRol" maxWidth="Infinity" promptText="Rol"/>

    <Label fx:id="lblEstado" styleClass="error-label" wrapText="true"/>

    <HBox spacing="10">
        <Button text="Guardar" styleClass="btn-primary" onAction="#guardar"/>
        <Button text="Cancelar" styleClass="btn-secondary" onAction="#cancelar"/>
    </HBox>
</VBox>

