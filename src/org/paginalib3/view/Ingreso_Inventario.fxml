<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.paginalib3.controller.IngresoInventarioController"
            style="-fx-background-color:#F7F1E8; -fx-font-family:'Segoe UI';">
    <top>
        <HBox spacing="14" alignment="CENTER_LEFT" style="-fx-background-color:#3B1720; -fx-padding:18 24;">
            <Button text="← Volver" onAction="#volver" 
                    style="-fx-background-color:#E7F2ED; -fx-text-fill:#1F604B; -fx-font-weight:bold; -fx-background-radius:10; -fx-cursor:hand;"/>
            <VBox>
                <Label text="Ingreso de inventario" 
                       style="-fx-text-fill:#FFF8EF; -fx-font-size:24px; -fx-font-weight:bold;"/>
                <Label text="Registra entradas sin modificar el stock manualmente" 
                       style="-fx-text-fill:#D9A441;"/>
            </VBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="24" bottom="20" left="24"/>
            </padding>
            <HBox spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Libro"/>
                    <ComboBox fx:id="cmbLibro" onAction="#actualizarStockSeleccionado" maxWidth="Infinity"/>
                </VBox>
                <VBox prefWidth="130" spacing="5">
                    <Label text="Stock actual"/>
                    <Label fx:id="lblStockActual" text="-" 
                           style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:#7A2938;"/>
                </VBox>
                <VBox prefWidth="130" spacing="5">
                    <Label text="Cantidad"/>
                    <TextField fx:id="txtCantidad"/>
                </VBox>
            </HBox>
            
            <Label text="Observación"/>
            <TextArea fx:id="txtObservacion" prefRowCount="2" wrapText="true"/>
            
            <Button text="Registrar ingreso" onAction="#registrarIngreso" maxWidth="Infinity" 
                    style="-fx-background-color:#2F7D62; -fx-text-fill:white; -fx-font-weight:bold; -fx-padding:12; -fx-background-radius:11; -fx-cursor:hand;"/>
            
            <Label fx:id="lblEstado" wrapText="true" style="-fx-text-fill:#765F55;"/>
            
            <Label text="Movimientos recientes" style="-fx-font-size:17px; -fx-font-weight:bold;"/>
            
            <TableView fx:id="tblMovimientos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="130"/>
                    <TableColumn fx:id="colLibro" text="Libro" prefWidth="300"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="130"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="90"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="190"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
